
# %%
import pandas as pd
import numpy as np
from sklearn.model_selection import train_test_split, cross_val_score
from sklearn.linear_model import LinearRegression
from sklearn.metrics import mean_absolute_error
import xgboost as xgb
import warnings
warnings.filterwarnings('ignore')

train = pd.read_csv('/kaggle/input/competitions/home-data-for-ml-course/train.csv')
test  = pd.read_csv('/kaggle/input/competitions/home-data-for-ml-course/test.csv')

train_ids = train['Id'].copy()
test_ids  = test['Id'].copy()
train.set_index('Id', inplace=True)
test.set_index('Id', inplace=True)
# %%
col_drop = train.isnull().sum()[train.isnull().sum() > 800].index.tolist()
train.drop(col_drop, axis=1, inplace=True)
test.drop(col_drop, axis=1, inplace=True)

nums = train.select_dtypes(include=['int64','float64']).columns.tolist()
cats = train.select_dtypes(include=['object']).columns.tolist()
nums_no_target = [c for c in nums if c != 'SalePrice']

for col in nums_no_target:
    m = train[col].mean()
    train[col] = train[col].fillna(m)
    test[col]  = test[col].fillna(m)

for col in cats:
    m = train[col].mode()[0]
    train[col] = train[col].fillna(m)
    test[col]  = test[col].fillna(m)

train['SalePrice_Log'] = np.log1p(train['SalePrice'])
print("✅ Preprocessing done")

# %%
x = train.drop(['SalePrice', 'SalePrice_Log'], axis=1)
y = train['SalePrice_Log']

combined = pd.concat([x, test], axis=0, keys=['train', 'test'])
combined = pd.get_dummies(combined, columns=cats, drop_first=True)

x_encoded    = combined.xs('train')
test_encoded = combined.xs('test')

print("x_encoded:", x_encoded.shape, "| test:", test_encoded.shape)

# %%
# --- Linear Regression Baseline ---
x_tr, x_va, y_tr, y_va = train_test_split(x_encoded, y, test_size=0.2, random_state=45)

lr = LinearRegression()
lr.fit(x_tr, y_tr)
lr_mae = mean_absolute_error(y_va, lr.predict(x_va))
print(f"LinearRegression: MAE = {lr_mae:.5f}")

# --- XGBoost with 3 configurations ---
configs = [
    {"n_estimators": 1000, "learning_rate": 0.05, "max_depth": 4},
    {"n_estimators": 2000, "learning_rate": 0.01, "max_depth": 5},
    {"n_estimators": 3000, "learning_rate": 0.01, "max_depth": 4, "subsample": 0.8},
]

best_xgb_mae = float('inf')
best_config  = None

for i, cfg in enumerate(configs):
    model = xgb.XGBRegressor(**cfg, random_state=42, n_jobs=-1)
    model.fit(x_tr, y_tr)
    mae = mean_absolute_error(y_va, model.predict(x_va))
    print(f"XGBoost config {i+1}: MAE = {mae:.5f}")
    if mae < best_xgb_mae:
        best_xgb_mae = mae
        best_config = cfg

print(f"\n🏆 Best XGBoost MAE: {best_xgb_mae:.5f}")

# %%
# CV for Linear
lr_cv = -cross_val_score(LinearRegression(), x_encoded, y, 
                          cv=5, scoring='neg_mean_absolute_error').mean()
print(f"Linear CV MAE: {lr_cv:.5f}")

# CV for best XGBoost
xgb_cv = -cross_val_score(xgb.XGBRegressor(**best_config, random_state=42, n_jobs=-1), 
                          x_encoded, y, cv=5, scoring='neg_mean_absolute_error').mean()
print(f"XGBoost CV MAE: {xgb_cv:.5f}")

# %%
# Use the best model based on CV
if xgb_cv < lr_cv:
    print("Using XGBoost for final prediction")
    final_model = xgb.XGBRegressor(**best_config, random_state=42, n_jobs=-1)
else:
    print("Using LinearRegression for final prediction")
    final_model = LinearRegression()

final_model.fit(x_encoded, y)

# Predict
y_pred_log = final_model.predict(test_encoded)
y_pred     = np.expm1(y_pred_log)

# Clip
min_reasonable = train['SalePrice'].min() * 0.9
max_reasonable = train['SalePrice'].max() * 1.3
y_pred_clipped = np.clip(y_pred, a_min=min_reasonable, a_max=max_reasonable)

print(f"\nBefore Clip — Min: ${y_pred.min():,.0f} | Max: ${y_pred.max():,.0f}")
print(f"After Clip  — Min: ${y_pred_clipped.min():,.0f} | Max: ${y_pred_clipped.max():,.0f}")

# Submission
submission = pd.DataFrame({
    'Id': test_ids.values,
    'SalePrice': y_pred_clipped
})
submission.to_csv('submission.csv', index=False)
print(f"\n✅ Saved submission.csv | Shape: {submission.shape}")

# %%
submission_check = pd.read_csv('submission.csv')
print("Shape:", submission_check.shape)
print("NaN count:", submission_check.isnull().sum().sum())
print("Min:", submission_check['SalePrice'].min())
print("Max:", submission_check['SalePrice'].max())
print("\nFirst 5 rows:")
print(submission_check.head())

